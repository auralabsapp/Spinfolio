    "Le principe" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "How It Works"
          }
        }
      }
    },
    "Le prix d'achat et l'état du média servent à calculer la plus-value de cet exemplaire." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The purchase price and media condition are used to calculate this copy’s gain."
          }
        }
      }
    },
    "Le tag « %@ » existe déjà dans ta bibliothèque." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The tag “%@” already exists in your library."
          }
        }
      }
    },
    "Le tag « %@ » existe déjà. Touche-le ci-dessous pour l'appliquer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The tag “%@” already exists. Tap it below to apply it."
          }
        }
      }
    },
    "Le téléchargement s'exécute par tranches avec une pause entre chaque page afin de respecter le quota de 60 requêtes/minute de Discogs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The download runs in batches with a pause between each page to stay within Discogs’ quota of 60 requests per minute."
          }
        }
      }
    },
    "Le thème %@ Signature est inclus pour tous. Les 8 thèmes alternatifs sont débloqués avec le compte Premium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ Signature theme is included for everyone. The 8 alternative themes are unlocked with a Premium account."
          }
        }
      }
    },
    "Le thème Signature est inclus pour tous ; les 8 autres palettes sont Premium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The Signature theme is included for everyone; the 8 other palettes are Premium."
          }
        }
      }
    },
    "Le total investi ne compte que les exemplaires dont le prix d'achat est renseigné." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The total invested only includes copies with a purchase price entered."
          }
        }
