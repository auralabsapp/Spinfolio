    "%@ a déterminé l'emplacement exact de ce disque dans votre meuble." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ has determined the exact placement of this record on your shelf."
          }
        }
      }
    },
    "%@ est réservé aux comptes premium. Active le compte premium dans Réglages pour en profiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ is only available with a Premium account. Turn on Premium in Settings to unlock it."
          }
        }
      }
    },
    "%@ utilise deux champs personnalisés de ta collection Discogs : un pour le prix d'achat, un pour l'état du disque. Chacun est détecté automatiquement par mot-clé dans le nom du champ — « prix », « prix d'achat », « price », « purchase price », « bought for » ou « cost » pour le prix d'achat ; « Media Condition » ou « état du disque » pour l'état (en excluant « Sleeve Condition », qui concerne la pochette)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ uses two custom fields from your Discogs collection: one for the purchase price, one for the media condition. Each is detected automatically by keyword in the field name — \"prix\", \"prix d'achat\", \"price\", \"purchase price\", \"bought for\", or \"cost\" for the purchase price; \"Media Condition\" or \"état du disque\" for the condition (excluding \"Sleeve Condition\", which is about the sleeve)."
          }
        }
      }
    },
    "%@ utilise l'API publique Discogs mais n'est ni affilié à ni approuvé par Discogs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ uses the public Discogs API but is not affiliated with or endorsed by Discogs."
          }
        }
      }
    },
    "%@, %@" : {
