          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tags, turntable listens, price alerts, and preferences follow your account across all your devices. Turning sync off doesn’t erase anything: when you turn it back on, changes made in the meantime are merged with iCloud."
          }
        }
      }
    },
