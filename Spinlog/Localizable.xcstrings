        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Unlike tags, which are local data, these fields are synced with your Discogs account. They are saved automatically with the keyboard’s “OK” button, by tapping outside the field, or with the checkmark that appears next to a modified field."
          }
        }
      }
    },
