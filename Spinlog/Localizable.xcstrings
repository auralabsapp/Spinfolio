    },
    "La photo et la biographie s'afficheront au retour du réseau." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The photo and biography will appear once you’re back online."
          }
        }
      }
    },
    "La plus-value (cote moins prix payé) est une fonction Premium, dans Stats." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gain (value minus price paid) is a Premium feature, in Stats."
