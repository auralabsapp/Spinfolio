    "« %@ » (%@) est disponible dès %@ sur Discogs !" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@” (%2$@) is available from %3$@ on Discogs!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "« %1$@ » (%2$@) est disponible dès %3$@ sur Discogs !"
          }
        }
      }
    },
    "« Couleur du thème » ouvre les palettes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Theme Color” opens the palettes."
          }
        }
      }
    },
    "« Estimation de la collection » s'appuie sur l'historique des ventes Discogs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Collection Valuation” is based on Discogs sales history."
          }
        }
      }
    },
    "« Gestion des dossiers » : touche un dossier pour en faire le dossier d'ajout par défaut." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Folder Management”: tap a folder to make it the default folder for new additions."
          }
        }
      }
    },
    "« Gestion des tags » : glisse ou maintiens un tag pour le renommer, le fusionner ou le supprimer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Tag Management”: swipe or press and hold a tag to rename, merge or delete it."
          }
        }
      }
    },
    "« Ranger » est une fonction Premium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Shelve” is a Premium feature."
          }
        }
      }
    },
    "« Se déconnecter » est en bas de Réglages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Sign Out” is at the bottom of Settings."
          }
        }
      }
    },
    "« Supprimer mon compte… » propose d'effacer les données locales et iCloud, ou de supprimer le compte sur Discogs.com." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Delete My Account…” lets you erase local and iCloud data, or delete the account on Discogs.com."
          }
        }
      }
    },
    "« Toujours demander » te propose le dossier à chaque ajout." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“Always Ask” offers you the folder every time you add a record."
          }
        }
      }
    },
