            "value" : "Start Listening"
          }
        }
      }
    },
    "Le calcul automatique de l'emplacement exact de chaque album dans votre meuble est une fonctionnalité réservée aux membres premium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Automatically calculating the exact placement of each album on your shelf is a feature reserved for Premium members."
          }
        }
      }
    },
    "Le champ état du disque existe par défaut sur Discogs ; le champ prix d'achat, en revanche, doit être créé une fois manuellement (voir ci-dessous)." : {
      "localizations" : {
        "en" : {
