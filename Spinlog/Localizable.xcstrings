    "La photo et la biographie de l'artiste viennent d'Apple Music. Autorise %@ à y accéder dans les Réglages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The artist’s photo and biography come from Apple Music. Allow %@ to access it in Settings."
          }
        }
