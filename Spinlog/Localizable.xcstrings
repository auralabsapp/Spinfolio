    "Supprimer « %@ » ? Ses %lld exemplaires seront déplacés vers Uncategorized." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Delete “%1$@”? %#@copies@"
          },
          "substitutions" : {
            "copies" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "Its %arg copy will be moved to Uncategorized."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "Its %arg copies will be moved to Uncategorized."
                    }
                  },
                  "zero" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "This folder is empty."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Supprimer « %1$@ » ? %#@copies@"
          },
          "substitutions" : {
            "copies" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "machine_translated",
                      "value" : "Son exemplaire sera déplacé vers Uncategorized."
