    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinfolio uses Apple Music to play tracks from your albums and show artist photos in your statistics."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinfolio utilise Apple Music pour lire les titres de tes albums et afficher la photo des artistes dans tes statistiques."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinfolio uses the camera to scan your records' barcodes and find their Discogs pages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spinfolio utilise l'appareil photo pour scanner le code-barres de tes disques et retrouver leur fiche Discogs."
          }
        }
      }
    }
  },
  "version" : "1.3"
